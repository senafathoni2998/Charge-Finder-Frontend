# Copy this file to `.env` (or `.env.local`) and fill in the values.

# Backend API base URL — include the /api prefix, no trailing slash.
# Local dev example:
VITE_APP_BACKEND_URL=http://localhost:5000/api

# MapTiler API key for map tiles: https://cloud.maptiler.com/account/keys/
# If left empty, the map falls back to public OpenStreetMap tiles (dev only —
# OSM's tile usage policy disallows production-scale use).
VITE_MAPTILER_KEY=
